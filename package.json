{
  "name": "stellarlatex-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "engine:download": "node ./scripts/download-engine.mjs && node ./scripts/prepare-engine.mjs",
    "engine:update": "node ./scripts/download-engine.mjs --force && node ./scripts/prepare-engine.mjs",
    "pdfjs:prepare": "node ./scripts/prepare-pdfjs.mjs",
    "predev": "pnpm engine:download && pnpm pdfjs:prepare",
    "dev": "vite",
    "prebuild": "pnpm engine:download && pnpm pdfjs:prepare",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "fflate": "^0.8.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2",
    "pdfjs-dist": "^6.3.289"
  }
}
